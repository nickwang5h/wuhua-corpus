{
  "name": "wuhua",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run content:assets",
    "preview": "vite preview",
    "check:types": "tsc --noEmit",
    "check:content": "node --import tsx scripts/check-content.ts",
    "content:assets": "node --import tsx scripts/build-content-assets.ts",
    "test": "npm run check:boundaries && node --import tsx --test tests/*.test.ts",
    "build": "npm run check:content && npm run content:assets && npm run check:types && vite build",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "opencc-js": "1.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.186.0",
    "@wuhua/corpus": "file:vendor/wuhua-corpus-2026.9.24-d1.tgz"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
