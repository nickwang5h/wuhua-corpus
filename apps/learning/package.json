{
  "name": "wuhua-learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run content:assets",
    "preview": "vite preview",
    "check:types": "tsc --noEmit",
    "check:content": "node --import tsx scripts/check-content.ts",
    "content:assets": "node --import tsx scripts/build-content-assets.ts",
    "test": "npm run check:boundaries && node --import tsx --test tests/*.test.ts",
    "build": "npm run check:content && npm run content:assets && npm run check:types && vite build",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "opencc-js": "1.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@wuhua/corpus": "file:vendor/wuhua-corpus-2026.9.24-d1.tgz"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "remark-frontmatter": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "@types/mdx": "2.0.14",
    "@types/mdast": "4.0.4",
    "vfile": "6.0.3"
  }
}
