  "passages": [
    {
      "id": "lunyu-wikisource-2058123-1-1",
      "divisionId": "lunyu-wikisource-2058123-1",
      "locator": "學而 · 1.1",
      "sentences": [
        {
          "id": "lunyu-wikisource-2058123-1-1-s1",
          "text": "子曰：「學而時習之，不亦說乎？有朋自遠方來，不亦樂乎？人不知而不慍，不亦君子乎？」"
        }
      ],
      "referenceUrl": "https://zh.wikisource.org/wiki/%E8%AB%96%E8%AA%9E/%E5%AD%B8%E8%80%8C%E7%AC%AC%E4%B8%80?oldid=2058123"
    },
    {
      "id": "lunyu-wikisource-2058123-1-2",
      "divisionId": "lunyu-wikisource-2058123-1",
      "locator": "學而 · 1.2",
      "sentences": [
        {
          "id": "lunyu-wikisource-2058123-1-2-s1",
          "text": "有子曰：「其爲人也孝弟，而好犯上者，鮮矣；不好犯上，而好作亂者，未之有也。君子務本，本立而道生；孝弟也者，其爲仁之本與？」"
        }
      ],
      "referenceUrl": "https://zh.wikisource.org/wiki/%E8%AB%96%E8%AA%9E/%E5%AD%B8%E8%80%8C%E7%AC%AC%E4%B8%80?oldid=2058123"
    },
    {
      "id": "lunyu-wikisource-2058123-1-3",
      "divisionId": "lunyu-wikisource-2058123-1",
      "locator": "學而 · 1.3",
      "sentences": [
        {
          "id": "lunyu-wikisource-2058123-1-3-s1",
          "text": "子曰：「巧言令色，鮮矣仁。」"
        }
      ],
      "referenceUrl": "https://zh.wikisource.org/wiki/%E8%AB%96%E8%AA%9E/%E5%AD%B8%E8%80%8C%E7%AC%AC%E4%B8%80?oldid=2058123"
    },
    {
      "id": "lunyu-wikisource-2058123-1-4",
      "divisionId": "lunyu-wikisource-2058123-1",
      "locator": "學而 · 1.4",
      "sentences": [
        {
          "id": "lunyu-wikisource-2058123-1-4-s1",
          "text": "曾子曰：「吾日三省吾身：爲人謀而不忠乎？與朋友交而不信乎？傳不習乎？」"
        }
      ],
      "referenceUrl": "https://zh.wikisource.org/wiki/%E8%AB%96%E8%AA%9E/%E5%AD%B8%E8%80%8C%E7%AC%AC%E4%B8%80?oldid=2058123"
    },
    {
      "id": "lunyu-wikisource-2058123-1-5",
      "divisionId": "lunyu-wikisource-2058123-1",
      "locator": "學而 · 1.5",
      "sentences": [
        {
          "id": "lunyu-wikisource-2058123-1-5-s1",
          "text": "子曰：「道千乘之國，敬事而信，節用而愛人，使民以時。」"
        }
      ],
      "referenceUrl": "https://zh.wikisource.org/wiki/%E8%AB%96%E8%AA%9E/%E5%AD%B8%E8%80%8C%E7%AC%AC%E4%B8%80?oldid=2058123"
    },
    {
      "id": "lunyu-wikisource-2058123-1-6",
      "divisionId": "lunyu-wikisource-2058123-1",
      "locator": "學而 · 1.6",
      "sentences": [
        {
          "id": "lunyu-wikisource-2058123-1-6-s1",
          "text": "子曰：「弟子入則孝，出則弟，謹而信，汎愛眾，而親仁。行有餘力，則以學文。」"
        }
      ],
      "referenceUrl": "https://zh.wikisource.org/wiki/%E8%AB%96%E8%AA%9E/%E5%AD%B8%E8%80%8C%E7%AC%AC%E4%B8%80?oldid=2058123"
    },
    {
      "id": "lunyu-wikisource-2058123-1-7",
      "divisionId": "lunyu-wikisource-2058123-1",
      "locator": "學而 · 1.7",
      "sentences": [
        {
          "id": "lunyu-wikisource-2058123-1-7-s1",
          "text": "子夏曰：「賢賢易色；事父母，能竭其力；事君，能致其身；與朋友交，言而有信；雖曰未學，吾必謂之學已矣。」"
        }
      ],
      "referenceUrl": "https://zh.wikisource.org/wiki/%E8%AB%96%E8%AA%9E/%E5%AD%B8%E8%80%8C%E7%AC%AC%E4%B8%80?oldid=2058123"
    },
    {
      "id": "lunyu-wikisource-2058123-1-8",
      "divisionId": "lunyu-wikisource-2058123-1",
      "locator": "學而 · 1.8",
      "sentences": [
        {
          "id": "lunyu-wikisource-2058123-1-8-s1",
          "text": "子曰：「君子不重則不威，學則不固。主忠信，無友不如己者，過則勿憚改。」"
        }
      ],
      "referenceUrl": "https://zh.wikisource.org/wiki/%E8%AB%96%E8%AA%9E/%E5%AD%B8%E8%80%8C%E7%AC%AC%E4%B8%80?oldid=2058123"
    },
    {
      "id": "lunyu-wikisource-2058123-1-9",
      "divisionId": "lunyu-wikisource-2058123-1",
      "locator": "學而 · 1.9",
      "sentences": [
        {
          "id": "lunyu-wikisource-2058123-1-9-s1",
          "text": "曾子曰：「愼終追遠，民德歸厚矣。」"
        }
      ],
      "referenceUrl": "https://zh.wikisource.org/wiki/%E8%AB%96%E8%AA%9E/%E5%AD%B8%E8%80%8C%E7%AC%AC%E4%B8%80?oldid=2058123"
    },
    {
      "id": "lunyu-wikisource-2058123-1-10",
      "divisionId": "lunyu-wikisource-2058123-1",
      "locator": "學而 · 1.10",
      "sentences": [
        {
          "id": "lunyu-wikisource-2058123-1-10-s1",
          "text": "子禽問於子貢曰：「夫子至於是邦也，必聞其政，求之與？抑與之與？」子貢曰：「夫子溫、良、恭、儉、讓以得之。夫子之求之也，其諸異乎人之求之與？」"
        }
      ],
      "referenceUrl": "https://zh.wikisource.org/wiki/%E8%AB%96%E8%AA%9E/%E5%AD%B8%E8%80%8C%E7%AC%AC%E4%B8%80?oldid=2058123"
    },
    {
      "id": "lunyu-wikisource-2058123-1-11",
      "divisionId": "lunyu-wikisource-2058123-1",
      "locator": "學而 · 1.11",
      "sentences": [
        {
          "id": "lunyu-wikisource-2058123-1-11-s1",
          "text": "子曰：「父在觀其志，父沒觀其行。三年無改於父之道，可謂孝矣。」"
        }
      ],
      "referenceUrl": "https://zh.wikisource.org/wiki/%E8%AB%96%E8%AA%9E/%E5%AD%B8%E8%80%8C%E7%AC%AC%E4%B8%80?oldid=2058123"
    },
    {
      "id": "lunyu-wikisource-2058123-1-12",
      "divisionId": "lunyu-wikisource-2058123-1",
      "locator": "學而 · 1.12",
      "sentences": [
        {
          "id": "lunyu-wikisource-2058123-1-12-s1",
          "text": "有子曰：「禮之用，和爲貴；先王之道，斯爲美；小大由之。有所不行，知和而和，不以禮節之，亦不可行也。」"
        }
      ],
      "referenceUrl": "https://zh.wikisource.org/wiki/%E8%AB%96%E8%AA%9E/%E5%AD%B8%E8%80%8C%E7%AC%AC%E4%B8%80?oldid=2058123"
    },
    {
      "id": "lunyu-wikisource-2058123-1-13",
      "divisionId": "lunyu-wikisource-2058123-1",
      "locator": "學而 · 1.13",
      "sentences": [
        {
          "id": "lunyu-wikisource-2058123-1-13-s1",
          "text": "有子曰：「信近於義，言可復也；恭近於禮，遠恥辱也。因不失其親，亦可宗也。」"
        }
      ],
      "referenceUrl": "https://zh.wikisource.org/wiki/%E8%AB%96%E8%AA%9E/%E5%AD%B8%E8%80%8C%E7%AC%AC%E4%B8%80?oldid=2058123"
    },
    {
      "id": "lunyu-wikisource-2058123-1-14",
      "divisionId": "lunyu-wikisource-2058123-1",
      "locator": "學而 · 1.14",
      "sentences": [
        {
          "id": "lunyu-wikisource-2058123-1-14-s1",
          "text": "子曰：「君子食無求飽，居無求安，敏於事而愼於言，就有道而正焉：可謂好學也已。」"
        }
      ],
      "referenceUrl": "https://zh.wikisource.org/wiki/%E8%AB%96%E8%AA%9E/%E5%AD%B8%E8%80%8C%E7%AC%AC%E4%B8%80?oldid=2058123"
    },
    {
      "id": "lunyu-wikisource-2058123-1-15",
      "divisionId": "lunyu-wikisource-2058123-1",
      "locator": "學而 · 1.15",
      "sentences": [
        {
          "id": "lunyu-wikisource-2058123-1-15-s1",
          "text": "子貢曰：「貧而無諂，富而無驕，何如？」子曰：「可也。未若貧而樂，富而好禮者也」。子貢曰：「《詩》云：『如切如磋，如琢如磨。』其斯之謂與？」子曰：「賜也，始可與言《詩》已矣！吿諸往而知來者。」"
        }
      ],
      "referenceUrl": "https://zh.wikisource.org/wiki/%E8%AB%96%E8%AA%9E/%E5%AD%B8%E8%80%8C%E7%AC%AC%E4%B8%80?oldid=2058123"
    },
    {
      "id": "lunyu-wikisource-2058123-1-16",
      "divisionId": "lunyu-wikisource-2058123-1",
      "locator": "學而 · 1.16",
      "sentences": [
        {
          "id": "lunyu-wikisource-2058123-1-16-s1",
          "text": "子曰：「不患人之不己知，患不知人也。」"
        }
      ],
      "referenceUrl": "https://zh.wikisource.org/wiki/%E8%AB%96%E8%AA%9E/%E5%AD%B8%E8%80%8C%E7%AC%AC%E4%B8%80?oldid=2058123"
    }
  ],
