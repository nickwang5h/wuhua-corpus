{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "types": [
      "node"
    ],
    "declaration": true,
    "outDir": "lib",
    "rootDir": "."
  },
  "include": [
    "src",
    "scripts/read-book.ts"
  ]
}
