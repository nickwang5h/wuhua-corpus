{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run test:reading && npm run build:reading",
  "outputDirectory": "apps/reading/dist",
  "rewrites": [
    {
      "source": "/sources",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm --prefix apps/reading ci"
}
