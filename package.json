{
  "name": "wuhua",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/reading/vite.config.ts",
    "build": "npm run lessons:generate && npm run check:content && npm run build:reading && npm run build:learning",
    "preview": "vite preview --config apps/reading/vite.config.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "content:import": "node --import tsx scripts/import-wikisource.ts",
    "dev:learning": "vite --config apps/learning/vite.config.ts",
    "build:reading": "npm run content:assets && tsc --noEmit -p apps/reading/tsconfig.json && vite build --config apps/reading/vite.config.ts",
    "build:learning": "npm run content:assets && tsc --noEmit -p apps/learning/tsconfig.json && vite build --config apps/learning/vite.config.ts",
    "preview:learning": "vite preview --config apps/learning/vite.config.ts",
    "check:content": "npm run lessons:check && node --import tsx scripts/check-content.ts",
    "content:catalog": "node --import tsx scripts/catalog-content.ts",
    "check:types": "tsc --noEmit",
    "content:assets": "npm run lessons:generate && node --import tsx scripts/build-content-assets.ts",
    "predev": "npm run content:assets",
    "predev:learning": "npm run content:assets",
    "lessons:new": "node --import tsx scripts/new-lesson.ts",
    "lessons:generate": "node --import tsx scripts/build-lessons.ts",
    "lessons:check": "node --import tsx scripts/build-lessons.ts --check"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "opencc-js": "1.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
