{
  "name": "@wuhua/corpus",
  "version": "2026.10.19-pinyin2",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./lib/src/index.js",
    "./types": "./lib/src/types.js",
    "./validate": "./lib/src/validate.js",
    "./pinyin": "./lib/src/pinyin.js",
    "./editorial": "./lib/src/editorial.js",
    "./node": "./lib/scripts/read-book.js",
    "./sources/wikisource.json": "./sources/wikisource.json",
    "./package.json": "./package.json",
    "./pinyin-core": "./lib/src/pinyin-core.js",
    "./pinyin-generator": "./lib/src/pinyin-generator.js",
    "./pinyin-workflow": "./lib/src/pinyin-workflow.js"
  },
  "files": [
    "lib",
    "sources"
  ],
  "scripts": {
    "check:types": "tsc --noEmit",
    "check:corpus": "node --import tsx scripts/check-content.ts",
    "test": "npm run check:boundaries && node --import tsx --test tests/*.test.ts",
    "content:import": "node --import tsx scripts/import-wikisource.ts",
    "content:catalog": "node --import tsx scripts/catalog-content.ts",
    "content:correct": "node --import tsx scripts/correct.ts",
    "release": "npm run check:types && npm run check:content && npm test && npm run build && node --import tsx scripts/release.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-books.mjs",
    "check:content": "npm run check:corpus && npm run corpus:check && npm run corpus:route:check",
    "corpus:discover": "node --import tsx scripts/corpus.ts discover",
    "corpus:fetch": "node --import tsx scripts/corpus.ts fetch",
    "corpus:build": "node --import tsx scripts/corpus.ts build",
    "corpus:check": "node --import tsx scripts/corpus.ts check",
    "corpus:sync": "node --import tsx scripts/corpus.ts sync",
    "corpus:report": "node --import tsx scripts/corpus.ts report",
    "corpus:route:check": "node --import tsx scripts/corpus-route-pilot.ts",
    "corpus:route:preview": "node --import tsx scripts/corpus-route-pilot.ts --write",
    "pinyin:prepare": "node --import tsx scripts/pinyin.ts prepare",
    "pinyin:apply": "node --import tsx scripts/pinyin.ts apply"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "parse5": "^8.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "opencc-js": "1.4.2",
    "pinyin-pro": "3.29.4"
  }
}
