{
  "name": "@wuhua/corpus",
  "version": "2026.9.24-d1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./lib/src/index.js",
    "./types": "./lib/src/types.js",
    "./validate": "./lib/src/validate.js",
    "./pinyin": "./lib/src/pinyin.js",
    "./editorial": "./lib/src/editorial.js",
    "./node": "./lib/scripts/read-book.js",
    "./sources/wikisource.json": "./sources/wikisource.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "sources"
  ],
  "scripts": {
    "check:types": "tsc --noEmit",
    "check:corpus": "node --import tsx scripts/check-content.ts",
    "test": "npm run check:boundaries && node --import tsx --test tests/*.test.ts",
    "content:import": "node --import tsx scripts/import-wikisource.ts",
    "content:catalog": "node --import tsx scripts/catalog-content.ts",
    "release": "npm run check:types && npm run check:corpus && npm test && npm run build && node --import tsx scripts/release.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-books.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
